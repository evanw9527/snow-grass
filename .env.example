SNOW_GRASS_ENVIRONMENT=development
SNOW_GRASS_DATABASE_URL=sqlite+aiosqlite:///./snow_grass.db
SNOW_GRASS_CORS_ORIGINS=["http://localhost:5173"]
SNOW_GRASS_DEFAULT_MODEL_ID=deepseek-chat
SNOW_GRASS_MODELS_CONFIG_PATH=config/models.yaml
SNOW_GRASS_SKILLS_PATH=skills
SNOW_GRASS_SKILL_ADMIN_ENABLED=true
SNOW_GRASS_SKILL_MAX_INSTRUCTION_CHARS=100000
SNOW_GRASS_SKILL_MAX_TEST_CASES=50
SNOW_GRASS_SKILL_MAX_PACKAGE_FILES=200
SNOW_GRASS_SKILL_MAX_PACKAGE_CHARS=2000000
SNOW_GRASS_SKILL_SCRIPT_EXECUTION_ENABLED=true
SNOW_GRASS_SKILL_SCRIPT_TIMEOUT_SECONDS=30
SNOW_GRASS_SKILL_SCRIPT_MAX_OUTPUT_CHARS=65536

# Memory: SQLite logical hot/cold tiers and bounded model context.
SNOW_GRASS_MEMORY_ENABLED=true
SNOW_GRASS_MEMORY_WORKSPACE_ID=default
SNOW_GRASS_MEMORY_RECENT_MESSAGE_LIMIT=24
SNOW_GRASS_MEMORY_CONTEXT_TOKEN_BUDGET=12000
SNOW_GRASS_MEMORY_OUTPUT_TOKEN_RESERVE=4000
SNOW_GRASS_MEMORY_COMPACT_THRESHOLD=32
SNOW_GRASS_MEMORY_SUMMARY_TARGET_TOKENS=1200
SNOW_GRASS_MEMORY_RETRIEVAL_LIMIT=8
SNOW_GRASS_MEMORY_AUTO_EXTRACT_ENABLED=false

# Workflow run detail is traceable for 5 days; aggregate statistics are retained.
SNOW_GRASS_WORKFLOW_RUN_DETAIL_RETENTION_DAYS=5
SNOW_GRASS_WORKFLOW_RUN_CLEANUP_INTERVAL_MINUTES=60

# Provider keys stay on the server. Never expose them to Sedum.
DEEPSEEK_API_KEY=
GLM_API_KEY=
